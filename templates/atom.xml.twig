<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.siteTitle }}</title>
    <link href="{{ site.baseUrl }}atom.xml" rel="self"/>
    <link href="{{ site.baseUrl }}"/>
    <updated>{{ posts|first.date|date("c") }}</updated>
    <id>{{ site.baseUrl }}</id>
    <author>
        <name>{{ site.author }}</name>
    </author>

    {% for post in posts %}
    <entry>
        <title>{{ post.title }}</title>
        <link href="{{ post.url }}"/>
        <id>{{ post.url }}</id>
        <updated>{{ post.date|date("c") }}</updated>
        <summary>{{ post.description }}</summary>
        <content type="html"><![CDATA[{{ post.content|raw }}]]></content>
    </entry>
    {% endfor %}
</feed>
